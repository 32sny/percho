+        if (!this.operation?.waiting && this.session.isCompacting) phase = "compacting";
+        if (phase === "idle" && !this.session.isIdle) phase = "running";
+        return {
+            runtimeId: this.runtimeId, revision: this.revision, phase,
+            autoDispatchPaused: this.autoDispatchPaused,
+            ...(this.active ? { runId: this.active.runId } : {}),
+            ...(this.session.isCompacting ? { compactionKind: this.session._compactionAbortController ? "manual" : "auto" } : {}),
+            ...(this.operation ? { operation: { operationId: this.operation.id, messageId: this.operation.target?.id,
+                sendAfterStop: this.operation.sendAfterStop, startedAt: this.operation.startedAt, slow: this.operation.slow } } : {}),
+            items: [...this.records.values()].filter(r => !r.committed && !r.consumed).map(r => ({
+                messageId: r.id, source: r.source, mode: r.mode, state: r.state,
+                preview: r.payload.text.slice(0, 240), imageCount: r.payload.images?.length ?? 0,
+            })),
